<!--
	Added by cpack to the MSI (CPACK_WIX_PATCH_FILE).

	The shortcuts in the start menu and on the desktop, with the product icon
	(CPACK_WIX_PRODUCT_ICON): the program has no icon of its own. The same as
	cpack makes from CPACK_PACKAGE_EXECUTABLES, apart from the icon.

	Windows opens projects, symbols and title block templates with
	QElectroTech. The .qet type is the one of the official installer
	(build-aux/windows/QElectroTech.wxs), so the link stays when either MSI
	replaces the other. No data folder arguments: the program finds its data
	from its own folder.
-->
<CPackWiXPatch>
	<CPackWiXFragment Id="#PRODUCT">
		<StandardDirectory Id="ProgramMenuFolder">
			<Component Id="QET_StartMenuShortcut" Guid="*">
				<Shortcut Id="QET_StartMenuShortcut" Name="FaseCAD"
					Target="[INSTALL_ROOT]bin\fasecad.exe"
					WorkingDirectory="CM_DP_bin" Icon="ProductIcon.ico" />
				<RegistryValue Root="HKCU"
					Key="Software\FaseCAD\FaseCAD"
					Name="installed" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</StandardDirectory>
		<StandardDirectory Id="DesktopFolder">
			<Component Id="QET_DesktopShortcut" Guid="*">
				<Shortcut Id="QET_DesktopShortcut" Name="FaseCAD"
					Target="[INSTALL_ROOT]bin\fasecad.exe"
					WorkingDirectory="CM_DP_bin" Icon="ProductIcon.ico" />
				<RegistryValue Root="HKCU"
					Key="Software\FaseCAD\FaseCAD"
					Name="installed_desktop" Type="integer" Value="1"
					KeyPath="yes" />
			</Component>
		</StandardDirectory>

		<Component Id="QET_FileTypes" Directory="INSTALL_ROOT"
			Guid="664F2292-540B-4AE4-B714-2906974A5609">
			<RegistryValue Root="HKCR" Key=".qet" Type="string"
				Value="FaseCAD.Document" KeyPath="yes" />
			<RegistryValue Root="HKCR" Key=".qetz" Type="string"
				Value="FaseCAD.Document" />
			<RegistryValue Root="HKCR" Key=".qetdb" Type="string"
				Value="FaseCAD.Document" />
			<RegistryValue Root="HKCR" Key="FaseCAD.Document" Type="string"
				Value="FaseCAD Project" />
			<RegistryValue Root="HKCR" Key="FaseCAD.Document\DefaultIcon"
				Type="string"
				Value="[INSTALL_ROOT]ico\application-x-qet-project.ico" />
			<RegistryValue Root="HKCR"
				Key="FaseCAD.Document\shell\open\command" Type="string"
				Value="&quot;[INSTALL_ROOT]bin\fasecad.exe&quot; &quot;%1&quot;" />

			<RegistryValue Root="HKCR" Key=".elmt" Type="string"
				Value="FaseCAD.Symbol" />
			<RegistryValue Root="HKCR" Key="FaseCAD.Symbol" Type="string"
				Value="FaseCAD Symbol" />
			<RegistryValue Root="HKCR" Key="FaseCAD.Symbol\DefaultIcon"
				Type="string"
				Value="[INSTALL_ROOT]ico\application-x-qet-element.ico" />
			<RegistryValue Root="HKCR"
				Key="FaseCAD.Symbol\shell\open\command" Type="string"
				Value="&quot;[INSTALL_ROOT]bin\fasecad.exe&quot; &quot;%1&quot;" />

			<RegistryValue Root="HKCR" Key=".titleblock" Type="string"
				Value="FaseCAD.TitleBlock" />
			<RegistryValue Root="HKCR" Key="FaseCAD.TitleBlock" Type="string"
				Value="FaseCAD Title Block Template" />
			<RegistryValue Root="HKCR" Key="FaseCAD.TitleBlock\DefaultIcon"
				Type="string"
				Value="[INSTALL_ROOT]ico\application-x-qet-titleblock.ico" />
			<RegistryValue Root="HKCR"
				Key="FaseCAD.TitleBlock\shell\open\command" Type="string"
				Value="&quot;[INSTALL_ROOT]bin\fasecad.exe&quot; &quot;%1&quot;" />
		</Component>
	</CPackWiXFragment>
	<CPackWiXFragment Id="#PRODUCTFEATURE">
		<ComponentRef Id="QET_StartMenuShortcut" />
		<ComponentRef Id="QET_DesktopShortcut" />
		<ComponentRef Id="QET_FileTypes" />
	</CPackWiXFragment>
</CPackWiXPatch>
