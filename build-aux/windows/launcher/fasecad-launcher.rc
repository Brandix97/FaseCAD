// The icon and the description of FaseCAD.exe, the launcher of the
// portable folder (see fasecad-launcher.c)
#include <windows.h>

1 ICON "../nsis_base/files/ico/fasecad.ico"

1 VERSIONINFO
FILEVERSION 0,11,0,0
PRODUCTVERSION 0,11,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "FaseCAD"
			VALUE "FileDescription", "FaseCAD"
			VALUE "FileVersion", "0.11"
			VALUE "InternalName", "FaseCAD"
			VALUE "LegalCopyright", "GNU General Public License v2 or later"
			VALUE "OriginalFilename", "FaseCAD.exe"
			VALUE "ProductName", "FaseCAD"
			VALUE "ProductVersion", "0.11"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
